# Copiez ce fichier en « keystore.properties » (jamais publié : voir .gitignore) et remplissez-le.
# La clé de signature se crée UNE SEULE FOIS (Android Studio › Build › Generate Signed App Bundle / APK › Create new…)
# puis se garde précieusement : sans elle, impossible de publier une mise à jour installable.
storeFile=fluxlite-publication.jks
storePassword=MOT_DE_PASSE_DU_MAGASIN
keyAlias=fluxlite
keyPassword=MOT_DE_PASSE_DE_LA_CLE
